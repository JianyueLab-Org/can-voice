{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "xpc-for-can",
  "version": "27.0.3",
  "identifier": "net.ceruleanavi.xpc-for-can",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:4332",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "title": "xpc-for-can",
        "width": 940,
        "height": 680,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../plugin/PI_XpcTraffic.py": "PythonPlugins/PI_XpcTraffic.py"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
