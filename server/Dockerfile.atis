# 服务端通播机队的镜像。
#
# 构建上下文是仓库根（Cargo workspace 在那儿）：
#     docker build -f server/Dockerfile.atis -t can-voice-atis .
#
# **它和语音服务端是两个镜像，不是一个。** 服务端是纯 Go、静态、distroless
# ——没有 shell、没有包管理器。机队要 Python（edge-tts）和 ffmpeg，把它们塞进
# 服务端那个镜像，就是为了一个每 30 秒跑一次的合成任务，给一个转发着所有人
# 语音的进程加上一个 Python 运行时和一整套 Debian 依赖。

FROM rust:1-bookworm AS build
# **ALSA 的头文件，给一个永远不会碰声卡的容器。**
#
# `can-voice-client` 无条件依赖 cpal（音频设备 I/O），所以 `alsa-sys` 的
# build script 要找得到 alsa 的 pkg-config。机队**运行时**一个设备都不开
# ——它给的 Config 里 `audio_devices: false`，音频是 TTS 合成出来的 PCM 直接
# push 进去的。
#
# 所以这一行纯粹是为了让链接过得去。想去掉的话得把 cpal 放进
# `can-voice-client` 的一个 feature 后面，那是四个桌面端一起动的改动，
# 不值得为一个 Dockerfile 里的两行做。
RUN apt-get update && apt-get install -y --no-install-recommends \
        libasound2-dev pkg-config \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY crates/ ./crates/
# apps/ 不拷：它们是 Tauri 客户端，各自有自己的 workspace。
RUN cargo build --release --locked -p can-voice-atis --bin can-voice-atis

# 运行时要 ffmpeg 和 edge-tts，所以不能是 distroless。
FROM debian:bookworm-slim
# libasound2 是**运行时**也要的：cpal 动态链接 libasound.so.2，哪怕一个设备
# 都不开，缺了它进程起不来（报 "cannot open shared object file"）。
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates ffmpeg python3 python3-pip libasound2 \
    && pip3 install --no-cache-dir --break-system-packages edge-tts \
    && apt-get purge -y python3-pip \
    && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /src/target/release/can-voice-atis /usr/local/bin/can-voice-atis
# 合成走临时文件（一台机器上会有好几路同时在合成，文件名带 pid 和自增号）。
# 不用 root：这个进程只读 datafeed、写 /tmp、往外发 UDP，没有一样要特权。
RUN useradd --create-home --uid 10001 atis
USER atis

# 健康检查查的是三件**运行时**的事，而它们全都是"构建绿、运行死"的那一类：
#
#   1. PID 1 还是机队自己。这个镜像的 ENTRYPOINT 是 exec 形式，所以进程名就在
#      /proc/1/comm 里（`can-voice-atis` 十四个字符，没到内核截断的十五）。
#      读 /proc 而不是 pgrep：pgrep 要 procps，为这一行装一个包不值当；而
#      `pgrep -f can-voice-atis` 还会匹配上健康检查自己那条命令行，永远是真。
#      **前提是 PID 1 就是它**：compose 里哪天加了 `init: true`，PID 1 会变成
#      docker-init，这一条就永远是假，症状是容器一直 unhealthy 而机队好好地播着。
#   2. ffmpeg 在。合成那一步是 `edge-tts → mp3 → ffmpeg -f s16le → PCM`
#      （crates/can-voice-atis/src/tts.rs），缺了它每一次合成都失败，而进程
#      照常活着——全网通播是哑的，容器状态是绿的。
#   3. edge_tts 这个模块导得进来。缺了同样是哑播：pip 那一层装坏了、或者哪天
#      基础镜像换了 Python 大版本，症状都在这里。
#
# 这不检查"真的在播"——那要一张真票和一个真席位，健康检查里不该有。
HEALTHCHECK --interval=60s --timeout=15s --start-period=30s --retries=3 \
    CMD grep -qx can-voice-atis /proc/1/comm \
     && ffmpeg -version >/dev/null 2>&1 \
     && python3 -c 'import edge_tts' >/dev/null 2>&1

ENTRYPOINT ["/usr/local/bin/can-voice-atis"]
