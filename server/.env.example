# 复制成 .env 再填。**.env 不要提交**。

# 证书所在的域名。用来拼 /etc/letsencrypt/live/<域名>/ 下的两个文件名，
# 所以要和 certbot 申请时用的那个一字不差。
CAN_VOICE_DOMAIN=audio.ceruleanavi.net

# can-api 的 Ed25519 **公钥**，裸 32 字节的 base64。
#
# 由 can-api 那边 `go run ./cmd/voice-keygen` 一次生成两半：私钥进 can-api 的
# VOICE_TOKEN_KEY，公钥进这里。**两半很容易放反**，而放反的表现是所有人都连不上、
# 日志里写 "token signature does not verify"——读起来像密钥错了，而不像是拿反了。
CAN_VOICE_API_PUBKEY=

# 对外的 UDP 端口。改这个不用动容器里的 :64738。
CAN_VOICE_PORT=64738

# 回滚：钉到某次构建的 sha-<commit>（CI 每次推 latest 的同时推一个）。空着就是 :latest。
#CAN_VOICE_IMAGE=ghcr.io/jianyuelab-org/can-voice:sha-<commit>
#CAN_VOICE_ATIS_IMAGE=ghcr.io/jianyuelab-org/can-voice-atis:sha-<commit>

# 下面几项都有默认值，不填就行。
#CAN_VOICE_FSD_FEED=https://data.ceruleanavi.net/v1/events
#CAN_VOICE_MAX_RX=32
#CAN_VOICE_DEBUG=1

# ── 服务端通播机队 ──────────────────────────────────────────────────────
# **不填这两项，通播就是哑的。** 桌面那支 atis-for-can 只挂 FSD 席位、发文字。

# 机队登录用的**真实成员账号**，rating ≥ 1。网络上没有保留账号旁路——这一支和
# 所有人走同一条路：拿凭据去 can-api 换一张短期票，而未定级的账号换不到票
# （can-api 回 403 `insufficient_rating`，日志里说的是 rating，不是密码）。
# 留空等于没填：机队会点出变量名然后退出，而不是起来之后一声不出。
ATIS_CID=
ATIS_PASSWORD=

# 下面几项都有默认值，不填就行。
#CAN_API_ORIGIN=https://api.ceruleanavi.net
#CAN_VOICE_SERVER=audio.ceruleanavi.net:64738
#CAN_VOICE_SERVER_NAME=audio.ceruleanavi.net
#CAN_FSD_DATAFEED=https://data.ceruleanavi.net/v1/data.json
# 轮询 datafeed 的间隔，下限 5 秒：写坏或者更小机队起不来。
#ATIS_POLL_SECS=30
# 默认是 can-audio 播的那两个男声。换掉全网都听得出来。
#ATIS_VOICE_EN=en-US-ChristopherNeural
#ATIS_VOICE_ZH=zh-CN-YunxiNeural
#ATIS_LOG=info
